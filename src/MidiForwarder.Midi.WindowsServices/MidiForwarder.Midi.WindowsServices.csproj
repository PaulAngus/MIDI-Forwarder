<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <CSWinRTInputs>Windows.Devices.Midi2</CSWinRTInputs>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.57\winmd</CsWinRTWindowsMetadata>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MidiForwarder.Core/MidiForwarder.Core.csproj" />
