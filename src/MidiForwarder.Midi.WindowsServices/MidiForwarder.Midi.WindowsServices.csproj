    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.75-devpreview.8" PrivateAssets="all" />
    <None Include="$(NuGetPackageRoot)windows.devices.midi2\0.99.75-devpreview.8\runtimes\win-x64\native\Windows.Devices.Midi2.dll"
          Link="Windows.Devices.Midi2.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)windows.devices.midi2\0.99.75-devpreview.8\runtimes\win-x64\native\Windows.Devices.Midi2.pri"
          Link="Windows.Devices.Midi2.pri"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
