<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiForwarder.Client.ClientWindow"
        Width="520" MinWidth="400" MinHeight="360" MaxHeight="700"
        SizeToContent="Height" FontSize="14"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Styles>
    <StyleInclude Source="/Assets/FluentUtilityStyles.axaml" />
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="MainPanel" Margin="24">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <StackPanel Spacing="8">
            <TextBlock Text="Client" Classes="secondary" />
            <TextBlock Text="MIDI Forwarder" FontSize="24" FontWeight="Medium" />
          </StackPanel>
          <Border Name="StatusPill" Grid.Column="1" Classes="status" Padding="12,6" CornerRadius="16" VerticalAlignment="Center" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" />
              <TextBlock Name="StatusText" Text="Disconnected" FontSize="12" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <Grid ColumnDefinitions="40,*,Auto">
              <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                <Image Name="EndpointLogo" Width="32" Height="32" Stretch="Uniform" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Name="EndpointTitle" Text="MIDI Forwarder" FontSize="18" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Name="EndpointSubtitle" Text="Virtual MIDI interface" Classes="secondary" TextWrapping="Wrap" />
              </StackPanel>
              <Button Name="ToggleClientButton" Grid.Column="2" Content="Connect" VerticalAlignment="Center" />
            </Grid>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
              <StackPanel Spacing="4">
                <TextBlock Name="ServerSummary" Text="Disconnected" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Name="ConnectionDetail" Text="Connect to start forwarding MIDI." Classes="secondary" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid Name="ActivityGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,24,0,0">
              <StackPanel Name="ToServerActivity" Orientation="Horizontal" Spacing="12">
                <Border Name="ToServerLamp" Classes="activityLamp" CornerRadius="8" Padding="4" VerticalAlignment="Center"><Ellipse Width="8" Height="8" /></Border>
                <StackPanel Spacing="2"><TextBlock Text="MIDI app → server" Classes="sectionTitle" /><TextBlock Name="ToServerState" Text="No activity" Classes="secondary activityState" /></StackPanel>
              </StackPanel>
              <Border Name="ToAppActivity" Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Name="ToAppLamp" Classes="activityLamp" CornerRadius="8" Padding="4" VerticalAlignment="Center"><Ellipse Width="8" Height="8" /></Border>
                  <StackPanel Spacing="2"><TextBlock Text="Server → MIDI app" Classes="sectionTitle" /><TextBlock Name="ToAppState" Text="No activity" Classes="secondary activityState" /></StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
        <Border Name="ErrorBanner" IsVisible="False" Background="{DynamicResource ErrorSoftBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
          <TextBlock Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Name="SettingsButton" Content="Settings" HorizontalAlignment="Left" />
        <Button Name="HideButton" Grid.Column="1" Classes="quiet" Content="Hide" FontSize="12" />
        <Button Name="QuitButton" Grid.Column="2" Classes="quiet" Content="Quit" FontSize="12" Margin="8,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
