<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MidiForwarder.Server</AssemblyName>
    <ApplicationIcon>../../assets/midi-forwarder.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Prefer a smaller download over precompiled startup code. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>../../publish/server/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MidiForwarder.Core/MidiForwarder.Core.csproj" />
    <ProjectReference Include="../MidiForwarder.Midi.WinMM/MidiForwarder.Midi.WinMM.csproj" />
    <ProjectReference Include="../MidiForwarder.Midi.WindowsServices/MidiForwarder.Midi.WindowsServices.csproj" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Win32" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <AvaloniaResource Include="../../assets/midi-forwarder.ico" Link="Assets/midi-forwarder.ico" />
    <AvaloniaResource Include="../../assets/midi-forwarder-256.png" Link="Assets/midi-forwarder-256.png" />
    <Compile Include="../../tools/BrandAssets.cs" Link="BrandAssets.cs" />
  </ItemGroup>
</Project>

