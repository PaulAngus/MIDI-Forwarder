<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MidiForwarder.Core/MidiForwarder.Core.csproj" />
    <ProjectReference Include="../../src/MidiForwarder.Midi.WindowsServices/MidiForwarder.Midi.WindowsServices.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <PropertyGroup Condition="('$(TestLabProfile)' == 'OfflineWindows' or '$(TestLabProfile)' == 'PhysicalWindowsReadOnly')"><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup Condition="('$(TestLabProfile)' == 'OfflineWindows' or '$(TestLabProfile)' == 'PhysicalWindowsReadOnly')">
    <Compile Include="Midi1CompatiblePortTests.cs" />
    <Compile Include="Midi1ShortMessageCodecTests.cs" />
    <Compile Include="MidiDeviceDiscoveryTests.cs" />
    <Compile Include="MidiFrameTests.cs" />
    <Compile Include="MidiTrafficMonitorTests.cs" />
    <Compile Include="UmpMidi1CodecTests.cs" />
    <Compile Include="WindowsMidiBackendTests.cs" />
    <Compile Include="WindowsUmpReceiveQueueTests.cs" />
    <Compile Include="WinMmSysExAssemblerTests.cs" />
  </ItemGroup>
</Project>
