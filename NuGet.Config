<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <packageSources>
    <clear />
    <add key="shared-midi" value="dependencies/midi" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="local-packages" />
    <add key="test-lab" value="dependencies/test-lab" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".build/nuget-contained" />
  </config>
  <packageSourceMapping>
    <packageSource key="shared-midi">
      <package pattern="MightBeUseful.Midi" />
      <package pattern="MightBeUseful.Midi.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="*" />
    </packageSource>
    <packageSource key="test-lab">
      <package pattern="ApplicationTestLab.Agent" />
    </packageSource>
  </packageSourceMapping>
</configuration>